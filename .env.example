# =============================================================================
# cloud-monitor – environment configuration
# Copy this file to .env and fill in your values.
# =============================================================================

# -----------------------------------------------------------------------------
# Reddit API (required)
# Create a Reddit app at https://www.reddit.com/prefs/apps (select "script")
# -----------------------------------------------------------------------------
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
REDDIT_USER_AGENT=cloud-monitor/1.0 (by u/your_reddit_username)

# Subreddits to monitor (joined with +, no spaces)
REDDIT_SUBREDDITS=aws+gcpcloud+developersIndia

# How many recent posts to fetch per cycle (default: 25)
REDDIT_POST_LIMIT=25

# Seconds between polling cycles (default: 300 = 5 minutes)
REDDIT_POLL_INTERVAL_SECONDS=300

# -----------------------------------------------------------------------------
# Google Gemini API (required)
# Get a key at https://aistudio.google.com/apikey
# -----------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key

# Model to use (default: gemini-1.5-flash)
GEMINI_MODEL=gemini-1.5-flash

# Temperature for analysis (lower = more deterministic, default: 0.2)
GEMINI_ANALYSIS_TEMPERATURE=0.2

# Temperature for draft generation (higher = more creative, default: 0.7)
GEMINI_DRAFT_TEMPERATURE=0.7

# Maximum tokens in the generated draft (default: 2048)
GEMINI_MAX_OUTPUT_TOKENS=2048

# -----------------------------------------------------------------------------
# Notifications (at least one channel required)
# -----------------------------------------------------------------------------

# -- Email (SMTP) --
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
EMAIL_FROM=your_email@gmail.com
EMAIL_TO=your_email@gmail.com

# -- Telegram --
# Create a bot via @BotFather and obtain the token.
# Chat ID: send a message to your bot then check
#   https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=123456789:ABCDefGhIjKlMnOpQrStUvWxYz
TELEGRAM_CHAT_ID=123456789

# -----------------------------------------------------------------------------
# Logging (optional)
# One of: DEBUG, INFO, WARNING, ERROR (default: INFO)
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
